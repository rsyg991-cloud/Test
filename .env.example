# Postgres. Locally: any Postgres; in production Vercel's Neon integration sets both variables.
DATABASE_URL="postgresql://bandup:bandup@localhost:5432/bandup"
DATABASE_URL_UNPOOLED="postgresql://bandup:bandup@localhost:5432/bandup"

# ---- AI evaluation (Writing, Speaking, AI-Conversation feedback) ----
# Which evaluator to use: "webhook" (n8n), "claude", or "mock" (offline demo).
# Leave empty to choose automatically: webhook if N8N_EVAL_WEBHOOK_URL is set, then Claude if a key is set, else mock.
AI_PROVIDER=""

# n8n webhook (see docs/n8n.md)
N8N_EVAL_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Claude API (optional alternative)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Set to 1 to force the offline demo evaluator
AI_MOCK="0"
# Max AI evaluations per learner per day
AI_DAILY_LIMIT="30"

# ---- Licensed full tests (see docs/licensed-tests.md) ----
# Folder with licensed test JSON files (keep outside the repository)
MOCK_TESTS_DIR=""
# Base URL for licensed audio/images stored privately
MOCK_ASSETS_BASE_URL=""
