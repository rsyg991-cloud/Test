# Database (SQLite for local dev). For production use a Postgres URL and set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Claude API key for AI grading of Writing & Speaking (server-side only)
ANTHROPIC_API_KEY=""
# Model used for grading (default: claude-opus-5-5)
CLAUDE_MODEL="claude-opus-5-5"
# Set to 1 to use the offline demo evaluator instead of calling the Claude API
AI_MOCK="0"
# Max AI evaluations per learner per day
AI_DAILY_LIMIT="30"
