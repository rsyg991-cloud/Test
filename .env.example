# Database (SQLite for local dev). For production use a Postgres URL and set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ---- AI evaluation (Writing, Speaking, AI-Conversation feedback) ----
# Which evaluator to use: "webhook" (n8n), "claude", or "mock" (offline demo).
# Leave empty to choose automatically: webhook if N8N_EVAL_WEBHOOK_URL is set, then Claude if a key is set, else mock.
AI_PROVIDER=""

# n8n webhook (see docs/n8n.md)
N8N_EVAL_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Claude API (optional alternative)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Set to 1 to force the offline demo evaluator
AI_MOCK="0"
# Max AI evaluations per learner per day
AI_DAILY_LIMIT="30"
